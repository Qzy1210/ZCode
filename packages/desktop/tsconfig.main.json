{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 这两个工程的 outDir 与 tsup 的打包产物同名(out/main/index.js、out/preload/index.js
    // 是 Electron 入口)。tsc 只做类型检查 + 声明产物,别把未打包的 .js 写到入口路径上——
    // 那会让不重新构建的启动加载到非 tsup 产物。
    "emitDeclarationOnly": true,
    "outDir": "out",
    // rootDir 放宽到 src:appARMSBootstrap 引用了 src/shared/armsRumShared.ts(与 preload
    // 共用的采集常量,见 tsconfig.preload.json 的同款处理)。实际打包由 tsup 完成,
    // 这里的 outDir/rootDir 只影响本工程的类型检查与假设的 emit 布局。
    "rootDir": "src",
    "lib": ["es2025"]
  },
  "include": ["src/main", "src/shared/armsRumShared.ts", "src/scheduler/schedulerProtocol.ts"],
  // main 直接依赖 shared 和 services；把引用补齐后，desktop 子工程也能稳定复用上游声明产物。
  "references": [{ "path": "../shared" }, { "path": "../services" }]
}
